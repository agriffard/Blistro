<section id="menu" class="section">
  <div class="container">
    <div class="section-copy">
      <p class="eyebrow">Menu</p>
      <h2 class="section-title">Seasonal French plates, poured with care.</h2>
    </div>
    <div class="menu-grid">
      {% for category in Categories %}
      <section class="menu-category" id="category-{{ category.Id }}">
        <h3>{{ category.Name }}</h3>
        <div class="menu-items">
          {% for item in category.Items %}
          <article class="menu-item">
            <img class="menu-item-image" src="{{ item.Image }}" alt="{{ item.Name }}" loading="lazy" />
            <div>
              <header>
                <h4>{{ item.Name }}</h4>
                <strong>{{ Currency }}{{ item.Price }}</strong>
              </header>
              <p>{{ item.Description }}</p>
              <div class="badge-row">
                {% for tag in item.Tags %}
                <span class="badge">{{ tag }}</span>
                {% endfor %}
                {% for allergen in item.Allergens %}
                <span class="badge allergen">{{ allergen }}</span>
                {% endfor %}
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>
  </div>
</section>
