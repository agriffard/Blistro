@inject ContentService ContentService

@if (_html is null)
{
    <section id="menu" class="section loading-section">
        <div class="container">
            <div class="loading-skeleton loading-heading"></div>
            <div class="loading-skeleton loading-card"></div>
            <div class="loading-skeleton loading-card"></div>
        </div>
    </section>
}
else
{
    @((MarkupString)_html)
}

@code {
    private string? _html;

    protected override async Task OnInitializedAsync()
    {
        _html = await ContentService.RenderSectionAsync<MenuModel>("data/menu.json", "templates/menu.liquid");
    }
}
