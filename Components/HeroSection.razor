@inject ContentService ContentService

@if (_html is null)
{
    <section id="hero" class="section hero-section loading-section">
        <div class="container">
            <div class="loading-skeleton loading-heading"></div>
            <div class="loading-skeleton loading-copy"></div>
            <div class="loading-skeleton loading-copy short"></div>
        </div>
    </section>
}
else
{
    @((MarkupString)_html)
}

@code {
    private string? _html;

    protected override async Task OnInitializedAsync()
    {
        _html = await ContentService.RenderSectionAsync<RestaurantModel>("data/restaurant.json", "templates/hero.liquid");
    }
}
